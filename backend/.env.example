# Gateway (LLM / embedding) endpoint
GATEWAY_BASE_URL=http://localhost:8080/v1
GATEWAY_API_KEY=changeme

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=claude-sonnet-4-5

# Vector dimensions for the embedding model (e.g. text-embedding-3-small = 1536)
EMBEDDING_DIM=1536

# Local data paths
LANCEDB_PATH=./data/lancedb
# Relative to backend/ (where uvicorn runs); root-level vault/ is the Git source-of-truth
VAULT_PATH=../vault

# Chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# Retrieval
RETRIEVE_TOPK=8

# Logging
LOG_LEVEL=INFO
