# Knowledge Platform reverse-proxy config.
#
# Listens on 80 (HTTP) and 443 (HTTPS).
#
# Entry points:
#   /app/*       the unified frontend (document tree + reader + AI chat)
#   /app/graph   the knowledge graph (force-directed canvas)
#   /v1/*        the backend API
#   /graph       the knowledge-graph API (JSON)
#   /open-webui/ Open WebUI — optional fallback, not the default entry point
#
# ---------------------------------------------------------------------------
# REQUIRED CONFIGURATION (set these before exposing the site)
#
#   SITE_ADDRESS              the public hostname, e.g. kb.internal.example.com
#                             default: localhost (Caddy issues a local cert)
#   Caddy_BasicAuth_Username  the login name       default: admin
#   Caddy_BasicAuth_Hash      the bcrypt password hash
#                             default: a built-in "change-me-now" password —
#                             CHANGE IT BEFORE EXPOSING THE SITE.
#
# Generate a hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#
# Authentication covers every route except /healthz, on both :80 and :443.
# There is no unauthenticated path into the knowledge base.
# ---------------------------------------------------------------------------
{
	# We handle the HTTP -> HTTPS redirect ourselves in the :80 block below.
	# Caddy's automatic redirect would fire *before* authentication and would
	# also swallow the unauthenticated /healthz probe.
	auto_https disable_redirects
}

# ---------- public HTTPS ----------
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# HTTP Basic auth. The matcher exempts /healthz so orchestrators can
	# probe liveness without credentials — it exposes nothing but `{"ok":true}`.
	# Both tokens must be present for `basic_auth` to parse; the directive is
	# rejected outright when the username or the hash is empty.
	@notHealth {
		not path /healthz
	}
	basic_auth @notHealth {
		{$Caddy_BasicAuth_Username:admin} {$Caddy_BasicAuth_Hash:$2a$14$Upb/gncl.3F9lHYVYZ6Qg.uryCsj25suyhTvtBQIK77VPYTnAoVKe}
	}

	# Health probe — deliberately unauthenticated.
	handle /healthz {
		reverse_proxy backend:8000
	}

	# The unified frontend SPA — FastAPI serves the build output and
	# falls back to index.html for the client-side routes (/app/graph, ...).
	handle /app/* {
		reverse_proxy backend:8000
	}

	# Knowledge platform backend routes
	handle /v1/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /metrics {
		reverse_proxy backend:8000
	}

	# Knowledge-graph data API. The SPA route lives under /app/graph.
	handle /graph* {
		reverse_proxy backend:8000
	}

	# Legacy static assets of the old standalone graph viewer.
	handle /static/graph/* {
		reverse_proxy backend:8000
	}

	# Open WebUI — optional fallback (multi-provider / agent scenarios).
	handle /open-webui/* {
		reverse_proxy open-webui:8080
	}

	# Everything else lands on the unified frontend.
	handle {
		redir /app/ 302
	}
}

# ---------- plaintext :80 ----------
# Serves the ACME http-01 challenge and redirects everything else to
# HTTPS. The same basic auth applies, so :80 is not an open door.
:80 {
	@notHealth {
		not path /healthz
	}
	basic_auth @notHealth {
		{$Caddy_BasicAuth_Username:admin} {$Caddy_BasicAuth_Hash:$2a$14$Upb/gncl.3F9lHYVYZ6Qg.uryCsj25suyhTvtBQIK77VPYTnAoVKe}
	}

	# Health probe for the platform itself (unauthenticated).
	handle /healthz {
		reverse_proxy backend:8000
	}

	# The unified frontend SPA.
	handle /app/* {
		reverse_proxy backend:8000
	}

	# Tunnels for the backend API/UI routes.
	handle /v1/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /metrics {
		reverse_proxy backend:8000
	}
	handle /static/graph/* {
		reverse_proxy backend:8000
	}
	handle /graph* {
		reverse_proxy backend:8000
	}

	# Open WebUI — optional fallback.
	handle /open-webui/* {
		reverse_proxy open-webui:8080
	}

	handle {
		redir https://{host}{uri} 308
	}
}
